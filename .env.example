# Knipsen Environment Variables Configuration Example

# HTTP Server Port
PORT=3000

# Environment Mode (development | production)
NODE_ENV=production

# Directory for storing uploaded photos & videos (Absolute or relative path)
UPLOAD_DIR=./uploads

# Path to SQLite database file
DATABASE_PATH=./data/knipsen.db

# Maximum allowed file upload size per file (in Megabytes)
MAX_FILE_SIZE_MB=100

# Base URL used for generating QR Code links and guest share URLs
# Change this to your domain/IP when hosting (e.g., https://wedding.example.com)
BASE_URL=http://localhost:3000
